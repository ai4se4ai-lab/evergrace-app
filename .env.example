# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# MVP default is a local SQLite file. To move to Postgres, see
# docs/DEPLOYMENT.md (swap the `provider` in prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Absolute base URL of the app. Used to build magic links.
APP_URL="http://localhost:3000"

# HMAC key for signed session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-me-with-32-bytes-of-hex"

# ---------------------------------------------------------------------------
# Seed admin (used only by `npm run db:seed`)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@evergrace.example"
SEED_ADMIN_PASSWORD="EverGrace!Admin1"

# ---------------------------------------------------------------------------
# Optional adapters. Every one of these is unset in the MVP, in which case the
# app runs against a documented in-process fallback. See
# docs/INTEGRATIONS.md for exactly what each one swaps in.
# ---------------------------------------------------------------------------

# Email delivery (Resend). Unset => magic links are written to the server log
# and surfaced in the dev-only "magic link" panel.
EMAIL_FROM="hello@evergrace.example"
RESEND_API_KEY=

# Billing (Stripe). Unset => plan changes go through the in-app mock billing
# provider, which mimics the webhook by updating User.plan server-side.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MEMBER=
STRIPE_PRICE_PREMIUM=

# Video hosting (Mux). Unset => admin upload registers a Video row with an
# optional direct source URL and the /api/media/webhook route stands in for
# Mux's `video.asset.ready` event.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# Shared secret required by POST /api/cron/recompute-status
CRON_SECRET="local-dev-cron-secret"

# Observability (Sentry). Unset => no-op.
SENTRY_DSN=
